{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/audiobook/alignment-item.schema.json",
  "title": "Audiobook Alignment Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["segment_id", "audio_file", "start", "end", "match_type", "confidence", "status"],
  "properties": {
    "segment_id": { "type": "string" },
    "audio_file": { "type": "string", "minLength": 1 },
    "start": { "type": ["number", "null"], "minimum": 0 },
    "end": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "match_type": { "enum": ["exact", "metadata", "asr_alignment", "forced_alignment", "manual"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "status": { "enum": ["matched", "review_required", "missing", "duplicate", "out_of_order", "overlap"] },
    "notes": { "type": "string" }
  }
}
